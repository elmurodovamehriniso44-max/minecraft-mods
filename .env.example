BOT_TOKEN=123456:ABC...
# Admin Telegram ID lar (vergul bilan)
ADMIN_IDS=11111111
# Majburiy obuna kanallari (bot kanalda ADMIN bo'lishi shart)
CHANNELS=@kanal1,@kanal2
# Inline rejimda audio file_id olish uchun "ombor" chat (bot yozishi mumkin bo'lgan shaxsiy kanal/chat ID).
# Bo'sh qolsa, birinchi admin ID ishlatiladi (admin botga /start bosgan bo'lishi kerak).
STORAGE_CHAT_ID=
DB_PATH=/data/bot.db
TMP_DIR=/tmp/linkshazam
MAX_PARALLEL=2
# Ixtiyoriy: Instagram/YouTube uchun cookies.txt (Netscape format) yo'li va proxy
COOKIES_FILE=
PROXY=
