# Telegram bot tokeni (@BotFather dan oling)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Administratorlar Telegram ID raqamlari (vergul bilan ajrating)
ADMIN_IDS=123456789,987654321

# --- Ixtiyoriy sozlamalar ---
# Ma'lumotlar bazasi fayli
DB_PATH=data/bot.db
# Yuklanadigan fayl uchun maksimal hajm (MB)
MAX_FILE_MB=100
# Admin panelda tanlanadigan Minecraft Bedrock versiyalari
MC_VERSIONS=1.21,1.20,1.19,1.18,1.17,1.16
# Foydalanuvchi uchun kunlik mod so'rovlari limiti
REQUEST_DAILY_LIMIT=3
